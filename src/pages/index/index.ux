  width: 100%;
  height: 100%;
  padding-top: 16px;
  padding-bottom: 16px;
  padding-left: 16px;
  padding-right: 16px;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  background-color: #0a0f0d;
}

.header {
  width: 304px;
  height: 60px;
  margin-bottom: 12px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.app-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.app-sub {
  font-size: 17px;
  color: #94a3b8;
  margin-top: 4px;
  text-align: center;
}

.primary-card {
  width: 304px;
  height: 122px;
  margin-bottom: 12px;
  border-radius: 22px;
  background-color: #22c55e;
  border-width: 2px;
  border-color: #4ade80;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-left: 14px;
  padding-right: 14px;
}

.primary-title {
  font-size: 32px;
  font-weight: bold;
  color: #052e16;
  text-align: center;
}

.primary-sub {
  font-size: 18px;
  color: #064e3b;
  margin-top: 6px;
  text-align: center;
}

.test-card {
  width: 304px;
  height: 108px;
  margin-bottom: 12px;
  border-radius: 22px;
  background-color: #132230;
  border-width: 2px;
  border-color: #38bdf8;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-left: 14px;
  padding-right: 14px;
}

.test-title {
  font-size: 28px;
  font-weight: bold;
  color: #e0f2fe;
  text-align: center;
}

.test-sub {
  font-size: 17px;
  color: #7dd3fc;
  margin-top: 6px;
  text-align: center;
}

.rule-bar {
  width: 304px;
  height: 40px;
  margin-bottom: 12px;
  border-radius: 12px;
  background-color: #121e19;
  border-width: 1px;
  border-color: #1f352b;
  justify-content: center;
  align-items: center;
  padding-left: 8px;
  padding-right: 8px;
}

.rule-text {
  font-size: 14px;
  color: #94a3b8;
  text-align: center;
}

.nav-row {
  width: 304px;
  height: 54px;
  flex-direction: row;
  justify-content: space-between;
}

.nav-btn {
  width: 146px;
  height: 54px;
  border-radius: 16px;
  background-color: #16221d;
  border-width: 1px;
  border-color: #263830;
  justify-content: center;
  align-items: center;
}

.nav-text {
  font-size: 20px;
  font-weight: bold;
  color: #e2e8f0;
  text-align: center;
}
</style>

<script>
import router from '@system.router'
import { DEFAULT_SETTINGS, loadSettings, loadMatchRecords } from '../../common/storageHelper'

export default {
  private: {
    settings: Object.assign({}, DEFAULT_SETTINGS),
    matchCount: 0
  },

  computed: {
    recordCountText() {
      return `已存 ${this.matchCount} 局记录`
    },
    thresholdSummary() {
      return `杀球 >${this.settings.smashThreshold} · 高远 >${this.settings.clearThreshold} · 有效 ≥${this.settings.minValidSpeed} km/h`
    }
  },

  async onShow() {
    const [settings, records] = await Promise.all([loadSettings(), loadMatchRecords()])
    this.settings = settings
    this.matchCount = Array.isArray(records) ? records.length : 0
  },

  goScore() {
    router.push({
      uri: '/pages/score'
    })
  },

  goTest() {
    router.push({
      uri: '/pages/test'
    })
  },

  goHistory() {
    router.push({
      uri: '/pages/history'
    })
  },

  goSettings() {
    router.push({
      uri: '/pages/settings'
    })
  }
}
</script>
