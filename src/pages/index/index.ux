<template>
  <div class="page">
    <div class="header">
      <text class="app-title">羽球对局</text>
      <text class="app-sub">{{recordCountText}}</text>
    </div>

    <div class="primary-card" onclick="goScore">
      <text class="primary-title">开一局</text>
      <text class="primary-sub">计分 + 自动测速判定</text>
    </div>

    <div class="test-card" onclick="goTest">
      <text class="test-title">挥拍测试</text>
      <text class="test-sub">调参 + 实时判定结果</text>
    </div>

    <div class="rule-bar" onclick="goSettings">
      <text class="rule-text">{{thresholdSummary}}</text>
    </div>

    <div class="nav-row">
      <div class="nav-btn" onclick="goHistory">
        <text class="nav-text">对局记录</text>
      </div>
      <div class="nav-btn" onclick="goSettings">
        <text class="nav-text">设置</text>
      </div>
    </div>
  </div>
</template>

<style>
