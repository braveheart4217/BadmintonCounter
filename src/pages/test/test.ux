  width: 304px;
  height: 390px;
  flex-direction: column;
}

.hero-card {
  width: 304px;
  height: 176px;
  border-radius: 20px;
  background-color: #121e19;
  border-width: 2px;
  border-color: #1f352b;
  padding-top: 12px;
  padding-bottom: 12px;
  padding-left: 14px;
  padding-right: 14px;
  margin-bottom: 10px;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.hero-top {
  width: 276px;
  height: 26px;
  margin-bottom: 6px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}

