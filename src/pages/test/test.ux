<template>
  <div class="page">
    <div class="header">
      <div class="header-btn" onclick="goBack">
        <text class="header-btn-text">返回</text>
      </div>
      <text class="title">挥拍测试</text>
      <div
        class="toggle-pill"
        style="background-color: {{toggleBg}}; border-color: {{toggleBorder}};"
        onclick="toggleMonitoring"
      >
        <text class="toggle-pill-text" style="color: {{toggleColor}};">{{toggleLabel}}</text>
      </div>
    </div>

    <scroll class="content-scroll" scroll-y="true">
      <div
        class="hero-card"
        style="background-color: {{heroBg}}; border-color: {{heroBorder}};"
      >
        <div class="hero-top">
          <div class="status-group">
            <div class="status-dot" style="background-color: {{dotColor}};"></div>
            <text class="status-text">{{statusText}}</text>
          </div>
          <text class="count-text">{{testCountText}}</text>
        </div>

        <text class="judgment-text" style="color: {{judgmentColor}};">{{judgmentText}}</text>
        <text class="speed-text">{{speedText}}</text>
        <text class="meta-text" style="color: {{metaColor}};">{{metaText}}</text>
      </div>

      <div class="rule-card">
        <text class="rule-text">{{rulePreviewText}}</text>
      </div>

      <div class="param-card">
        <div class="param-head">
          <text class="param-title">杀球阈值</text>
          <text class="param-sub">挥速 &gt; 此值判定为杀球 (km/h)</text>
        </div>
        <div class="stepper-row">
          <div class="step-btn" onclick="decSmash">
            <text class="step-btn-text">-</text>
          </div>
          <text class="step-value smash-val">{{smashText}}</text>
          <div class="step-btn" onclick="incSmash">
            <text class="step-btn-text">+</text>
          </div>
        </div>
      </div>

      <div class="param-card">
        <div class="param-head">
          <text class="param-title">高远球阈值</text>
          <text class="param-sub">挥速 &gt; 此值判定为高远球 (km/h)</text>
        </div>
        <div class="stepper-row">
          <div class="step-btn" onclick="decClear">
            <text class="step-btn-text">-</text>
          </div>
          <text class="step-value clear-val">{{clearText}}</text>
          <div class="step-btn" onclick="incClear">
            <text class="step-btn-text">+</text>
          </div>
        </div>
      </div>

      <div class="param-card param-card-last">
        <div class="param-head">
          <text class="param-title">有效挥拍下限</text>
          <text class="param-sub">低于此速度不记为有效挥拍 (km/h)</text>
        </div>
        <div class="stepper-row">
          <div class="step-btn" onclick="decMinValid">
            <text class="step-btn-text">-</text>
          </div>
          <text class="step-value valid-val">{{minValidText}}</text>
          <div class="step-btn" onclick="incMinValid">
            <text class="step-btn-text">+</text>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style>
