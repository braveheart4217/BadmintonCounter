  width: 304px;
  height: 48px;
  margin-bottom: 10px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}

.header-btn {
  width: 72px;
  height: 42px;
  border-radius: 14px;
  background-color: #16221d;
  border-width: 1px;
  border-color: #263830;
  justify-content: center;
  align-items: center;
}

.header-btn-text {
  font-size: 19px;
  color: #e2e8f0;
}

