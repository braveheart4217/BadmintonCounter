<template>
  <div class="page">
    <div class="header">
      <div class="header-btn" onclick="goBack">
        <text class="header-btn-text">返回</text>
      </div>
      <text class="title">应用设置</text>
      <div class="header-spacer"></div>
    </div>

    <scroll class="settings-scroll" scroll-y="true">
      <div class="setting-card-col">
        <div class="card-top">
          <text class="item-title">杀球阈值 (&gt; km/h)</text>
          <text class="item-sub">挥速大于此值判定为杀球（默认 150）</text>
        </div>
        <div class="stepper-row">
          <div class="step-btn" onclick="decSmash">
            <text class="step-btn-text">-</text>
          </div>
          <text class="step-value smash-val">{{smashText}}</text>
          <div class="step-btn" onclick="incSmash">
            <text class="step-btn-text">+</text>
          </div>
        </div>
      </div>

      <div class="setting-card-col">
        <div class="card-top">
          <text class="item-title">高远球阈值 (&gt; km/h)</text>
          <text class="item-sub">挥速大于此值判定为高远球（默认 100）</text>
        </div>
        <div class="stepper-row">
          <div class="step-btn" onclick="decClear">
            <text class="step-btn-text">-</text>
          </div>
          <text class="step-value clear-val">{{clearText}}</text>
          <div class="step-btn" onclick="incClear">
            <text class="step-btn-text">+</text>
          </div>
        </div>
      </div>

      <div class="setting-card-col">
        <div class="card-top">
          <text class="item-title">有效挥拍下限 (≥ km/h)</text>
          <text class="item-sub">低于此值不记为有效挥拍（默认 40）</text>
        </div>
        <div class="stepper-row">
          <div class="step-btn" onclick="decMinValid">
            <text class="step-btn-text">-</text>
          </div>
          <text class="step-value">{{minValidText}}</text>
          <div class="step-btn" onclick="incMinValid">
            <text class="step-btn-text">+</text>
          </div>
        </div>
      </div>

      <div class="setting-card-col">
        <div class="card-top">
          <text class="item-title">标定系数 K</text>
          <text class="item-sub">范围 1.0 - 4.0（默认 2.2）</text>
        </div>
        <div class="stepper-row">
          <div class="step-btn" onclick="decreaseCal">
            <text class="step-btn-text">-</text>
          </div>
          <text class="step-value">{{calibrationText}}</text>
          <div class="step-btn" onclick="increaseCal">
            <text class="step-btn-text">+</text>
          </div>
        </div>
      </div>

      <div class="setting-card" onclick="cycleSensitivity">
        <div class="card-left">
          <text class="item-title">触发灵敏度</text>
          <text class="item-sub">高档轻挥易触发</text>
        </div>
        <div class="pill-btn" style="background-color: #22c55e;">
          <text class="pill-text" style="color: #052e16;">{{sensitivityLabel}}</text>
        </div>
      </div>

      <div class="setting-card" onclick="toggleVibrate">
        <div class="card-left">
          <text class="item-title">杀球震动提示</text>
          <text class="item-sub">对局判定为杀球时震动示意</text>
        </div>
        <div class="pill-btn" style="background-color: {{vibrateBg}};">
          <text class="pill-text" style="color: {{vibrateTextColor}};">{{vibrateLabel}}</text>
        </div>
      </div>

      <div class="setting-card" onclick="toggleKeepScreenOn">
        <div class="card-left">
          <text class="item-title">对局常亮</text>
          <text class="item-sub">对局与测试期间防止熄屏</text>
        </div>
        <div class="pill-btn" style="background-color: {{keepScreenBg}};">
          <text class="pill-text" style="color: {{keepScreenTextColor}};">{{keepScreenLabel}}</text>
        </div>
      </div>

      <div class="reset-btn" onclick="onResetDefaults">
        <text class="reset-btn-text">{{resetLabel}}</text>
      </div>
    </scroll>
  </div>
</template>

