  height: 54px;
  border-radius: 16px;
  background-color: #261618;
  border-width: 1px;
  border-color: #7f1d1d;
  justify-content: center;
  align-items: center;
  margin-top: 4px;
  margin-bottom: 16px;
  flex-shrink: 0;
}

.reset-btn-text {
  font-size: 20px;
  color: #fca5a5;
}
</style>

<script>
import router from '@system.router'
import { SENSITIVITY_PRESETS } from '../../common/swingDetector'
import { adjustThreshold } from '../../common/swingClassifier'
import {
  DEFAULT_SETTINGS,
  loadSettings,
  saveSettings,
  resetSettingsToDefault
} from '../../common/storageHelper'

const SENSITIVITY_ORDER = ['low', 'medium', 'high']

export default {
  private: {
    settings: Object.assign({}, DEFAULT_SETTINGS),
    resetState: 'idle',
    resetTimer: null
  },

  computed: {
    smashText() {
      return `${this.settings.smashThreshold}`
    },
    clearText() {
      return `${this.settings.clearThreshold}`
    },
    minValidText() {
      return `${this.settings.minValidSpeed}`
    },
    calibrationText() {
      return this.settings.calibrationFactor.toFixed(1)
    },
    sensitivityLabel() {
      const preset = SENSITIVITY_PRESETS[this.settings.sensitivity] || SENSITIVITY_PRESETS.medium
      return preset.label
    },
    vibrateBg() {
      return this.settings.vibrate ? '#22c55e' : '#1e293b'
    },
    vibrateTextColor() {
      return this.settings.vibrate ? '#052e16' : '#94a3b8'
    },
    vibrateLabel() {
      return this.settings.vibrate ? '开' : '关'
    },
    keepScreenBg() {
      return this.settings.keepScreenOn ? '#22c55e' : '#1e293b'
    },
    keepScreenTextColor() {
      return this.settings.keepScreenOn ? '#052e16' : '#94a3b8'
    },
    keepScreenLabel() {
      return this.settings.keepScreenOn ? '开' : '关'
    },
    resetLabel() {
      if (this.resetState === 'confirm') {
        return '再点一次确认恢复'
      }
      if (this.resetState === 'done') {
        return '已恢复默认设置'
      }
      return '恢复默认设置'
    }
  },

  async onShow() {
    this.settings = await loadSettings()
  },

  onHide() {
    this.clearResetTimer()
  },

  onDestroy() {
    this.clearResetTimer()
  },

  clearResetTimer() {
    if (this.resetTimer) {
      clearTimeout(this.resetTimer)
      this.resetTimer = null
    }
  },

  async updateSettings(partial) {
    const next = Object.assign({}, this.settings, partial)
    this.settings = await saveSettings(next)
  },

  changeThreshold(key, delta) {
    const nextThresholds = adjustThreshold(this.settings, key, delta)
    this.updateSettings(nextThresholds)
  },

  decSmash() {
    this.changeThreshold('smashThreshold', -5)
  },

  incSmash() {
    this.changeThreshold('smashThreshold', 5)
  },

  decClear() {
    this.changeThreshold('clearThreshold', -5)
  },

  incClear() {
    this.changeThreshold('clearThreshold', 5)
  },

  decMinValid() {
    this.changeThreshold('minValidSpeed', -5)
  },

  incMinValid() {
    this.changeThreshold('minValidSpeed', 5)
  },

  decreaseCal() {
    const nextVal = Math.max(1.0, Math.round((this.settings.calibrationFactor - 0.1) * 10) / 10)
    this.updateSettings({ calibrationFactor: nextVal })
  },

  increaseCal() {
    const nextVal = Math.min(4.0, Math.round((this.settings.calibrationFactor + 0.1) * 10) / 10)
    this.updateSettings({ calibrationFactor: nextVal })
  },

  cycleSensitivity() {
    const idx = SENSITIVITY_ORDER.indexOf(this.settings.sensitivity)
    const nextKey = SENSITIVITY_ORDER[(idx + 1) % SENSITIVITY_ORDER.length]
    this.updateSettings({ sensitivity: nextKey })
  },

  toggleVibrate() {
    this.updateSettings({ vibrate: !this.settings.vibrate })
  },

  toggleKeepScreenOn() {
    this.updateSettings({ keepScreenOn: !this.settings.keepScreenOn })
  },

  async onResetDefaults() {
    if (this.resetState === 'idle') {
      this.resetState = 'confirm'
      this.clearResetTimer()
      this.resetTimer = setTimeout(() => {
        this.resetState = 'idle'
      }, 3000)
      return
    }

    if (this.resetState === 'confirm') {
      this.clearResetTimer()
      this.settings = await resetSettingsToDefault()
      this.resetState = 'done'
      this.resetTimer = setTimeout(() => {
        this.resetState = 'idle'
      }, 2000)
    }
  },

  goBack() {
    router.back()
  }
}
</script>
