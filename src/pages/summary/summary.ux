  color: #e2e8f0;
}
</style>

<script>
import router from '@system.router'
import { MATCH_MODES } from '../../common/scoreboard'
import { DEFAULT_THRESHOLDS, normalizeThresholds } from '../../common/swingClassifier'
import { formatDuration, formatMatchTime } from '../../common/matchSession'
import { getMatchRecordById, loadMatchRecords } from '../../common/storageHelper'

export default {
  protected: {
    matchId: '',
    fromHistory: ''
  },

  private: {
    record: null,
    hasRecord: false,
    winnerText: '平局结束',
    winnerColor: '#94a3b8',
    scoreText: '0 : 0',
    metaText: '--',
    smashCountText: '0 次',
    clearCountText: '0 次',
    normalCountText: '0 次',
    totalSwingsText: '0 次',
    maxSpeedText: '0 km/h',
    avgSpeedText: '0 km/h',
    thresholdText: ''
  },

  computed: {
    isFromHistory() {
      return this.fromHistory === '1'
    },
    pageTitle() {
      return this.fromHistory === '1' ? '对局详情' : '对局结算'
    }
  },

  async onShow() {
    let target = null
    if (this.matchId) {
      target = await getMatchRecordById(this.matchId)
    }
    if (!target) {
      const records = await loadMatchRecords()
      target = records.length > 0 ? records[0] : null
    }
    this.record = target
    this.applyRecord(target)
  },

  applyRecord(rec) {
    if (!rec) {
      this.hasRecord = false
      return
    }
    this.hasRecord = true

    if (rec.winner === 'my') {
      this.winnerText = '我方胜出'
      this.winnerColor = '#4ade80'
    } else if (rec.winner === 'opp') {
      this.winnerText = '对方胜出'
      this.winnerColor = '#93c5fd'
    } else {
      this.winnerText = '平局结束'
      this.winnerColor = '#facc15'
    }

    this.scoreText = `${rec.myScore} : ${rec.oppScore}`
    const modeObj = MATCH_MODES[rec.mode] || MATCH_MODES['21']
    const durStr = formatDuration(rec.durationSec)
    const timeStr = formatMatchTime(rec.endedAt || rec.startedAt)
    this.metaText = `${modeObj.label} · ${durStr} · ${timeStr}`

    const summary = rec.summary || {}
    this.smashCountText = `${summary.smashCount || 0} 次`
    this.clearCountText = `${summary.clearCount || 0} 次`
    this.normalCountText = `${summary.normalCount || 0} 次`
    this.totalSwingsText = `${summary.totalSwings || 0} 次`

    const maxSpd = Number(summary.maxSpeedKmh) || 0
    const avgSpd = Number(summary.avgSpeedKmh) || 0
    this.maxSpeedText = maxSpd > 0 ? `${maxSpd.toFixed(1)} km/h` : '--'
    this.avgSpeedText = avgSpd > 0 ? `${avgSpd.toFixed(1)} km/h` : '--'

    const th = normalizeThresholds(rec.thresholdsSnapshot || DEFAULT_THRESHOLDS)
    this.thresholdText = `判定阈值: 杀球>${th.smashThreshold} · 高远>${th.clearThreshold} · 有效≥${th.minValidSpeed} km/h`
  },

  playAgain() {
    router.replace({
      uri: '/pages/score'
    })
  },

  goBack() {
    router.back()
  }
}
</script>
