<template>
  <div class="page">
    <div class="header">
      <div class="header-btn" onclick="goBack">
        <text class="header-btn-text">返回</text>
      </div>
      <text class="title">{{pageTitle}}</text>
      <div class="header-spacer"></div>
    </div>

    <div class="empty-box" if="{{!hasRecord}}">
      <text class="empty-title">未找到对局记录</text>
      <div class="single-btn" onclick="goBack">
        <text class="action-btn-text">返回</text>
      </div>
    </div>

    <scroll class="content-scroll" scroll-y="true" if="{{hasRecord}}">
      <div class="hero-card">
        <text class="winner-badge" style="color: {{winnerColor}};">{{winnerText}}</text>
        <text class="score-line">{{scoreText}}</text>
        <text class="meta-line">{{metaText}}</text>
      </div>

      <div class="grid-row">
        <div class="stat-card smash-card">
          <text class="stat-label">杀球</text>
          <text class="stat-value smash-value">{{smashCountText}}</text>
        </div>
        <div class="stat-card clear-card">
          <text class="stat-label">高远球</text>
          <text class="stat-value clear-value">{{clearCountText}}</text>
        </div>
      </div>

      <div class="grid-row">
        <div class="stat-card">
          <text class="stat-label">普通挥拍</text>
          <text class="stat-value normal-value">{{normalCountText}}</text>
        </div>
        <div class="stat-card">
          <text class="stat-label">有效总挥拍</text>
          <text class="stat-value">{{totalSwingsText}}</text>
        </div>
      </div>

      <div class="grid-row">
        <div class="stat-card">
          <text class="stat-label">最高挥速</text>
          <text class="stat-value best-value">{{maxSpeedText}}</text>
        </div>
        <div class="stat-card">
          <text class="stat-label">平均挥速</text>
          <text class="stat-value">{{avgSpeedText}}</text>
        </div>
      </div>

      <div class="info-card">
        <text class="info-title">已保存至本地记录，供后续同步手机查看</text>
        <text class="info-sub">{{thresholdText}}</text>
      </div>

      <div class="btn-row" if="{{!isFromHistory}}">
        <div class="primary-btn" onclick="playAgain">
          <text class="primary-btn-text">再来一局</text>
        </div>
        <div class="secondary-btn" onclick="goBack">
          <text class="action-btn-text">返回首页</text>
        </div>
      </div>

      <div class="single-btn" if="{{isFromHistory}}" onclick="goBack">
        <text class="action-btn-text">返回列表</text>
      </div>
    </scroll>
  </div>
</template>

